diff --git a/Python-3.12.10/PC/launcher_debug.c b/Python-3.12.10/PC/launcher_debug.c
new file mode 100644
index 0000000..eaebe0e
--- /dev/null
+++ b/Python-3.12.10/PC/launcher_debug.c
@@ -0,0 +1,104 @@
+/* Unicode debug output shared by the two Windows launchers. */
+#include "launcher_debug.h"
+
+#include <io.h>
+#include <limits.h>
+#include <stdlib.h>
+
+BOOL
+write_debug(FILE *stream, const wchar_t *text, int text_length)
+{
+    /* Do not pass wide text through the CRT's locale conversion. Even
+     * _O_U8TEXT can split surrogate pairs when stderr is unbuffered. */
+    if (fflush(stream) == EOF) {
+        return FALSE;
+    }
+    int file_descriptor = _fileno(stream);
+    if (file_descriptor < 0) {
+        return FALSE;
+    }
+    HANDLE output_handle = (HANDLE)_get_osfhandle(file_descriptor);
+    if (output_handle == INVALID_HANDLE_VALUE) {
+        return FALSE;
+    }
+
+    /* Preserve the text stream's LF -> CRLF translation. */
+    int newline_count = 0;
+    for (int source_index = 0; source_index < text_length; ++source_index) {
+        if (text[source_index] == L'\n') {
+            ++newline_count;
+        }
+    }
+    if (text_length > INT_MAX - newline_count) {
+        return FALSE;
+    }
+    int translated_length = text_length + newline_count;
+    wchar_t *translated_text = malloc((size_t)translated_length * sizeof(wchar_t));
+    if (!translated_text) {
+        return FALSE;
+    }
+    int destination_index = 0;
+    for (int source_index = 0; source_index < text_length; ++source_index) {
+        if (text[source_index] == L'\n') {
+            translated_text[destination_index++] = L'\r';
+        }
+        translated_text[destination_index++] = text[source_index];
+    }
+
+    BOOL success = FALSE;
+    DWORD console_mode;
+    if (GetConsoleMode(output_handle, &console_mode)) {
+        DWORD character_offset = 0;
+        while (character_offset < (DWORD)translated_length) {
+            /* Bound console writes, keeping surrogate pairs together. */
+            DWORD chunk_length = (DWORD)translated_length - character_offset;
+            if (chunk_length > 16384) {
+                chunk_length = 16384;
+                wchar_t last_code_unit =
+                    translated_text[character_offset + chunk_length - 1];
+                if (last_code_unit >= 0xD800 && last_code_unit <= 0xDBFF) {
+                    --chunk_length;
+                }
+            }
+            DWORD characters_written;
+            if (!WriteConsoleW(output_handle, translated_text + character_offset,
+                               chunk_length, &characters_written, NULL)
+                || !characters_written) {
+                goto done;
+            }
+            character_offset += characters_written;
+        }
+        success = TRUE;
+    }
+    else {
+        int utf8_length = WideCharToMultiByte(
+            CP_UTF8, 0, translated_text, translated_length, NULL, 0, NULL, NULL);
+        if (!utf8_length) {
+            goto done;
+        }
+        char *utf8_buffer = malloc(utf8_length);
+        if (!utf8_buffer) {
+            goto done;
+        }
+        if (WideCharToMultiByte(
+               CP_UTF8, 0, translated_text, translated_length,
+               utf8_buffer, utf8_length, NULL, NULL
+           ) == utf8_length) {
+            DWORD byte_offset = 0;
+            while (byte_offset < (DWORD)utf8_length) {
+                DWORD bytes_written;
+                if (!WriteFile(output_handle, utf8_buffer + byte_offset,
+                               (DWORD)utf8_length - byte_offset,
+                               &bytes_written, NULL) || !bytes_written) {
+                    break;
+                }
+                byte_offset += bytes_written;
+            }
+            success = byte_offset == (DWORD)utf8_length ? TRUE : FALSE;
+        }
+        free(utf8_buffer);
+    }
+done:
+    free(translated_text);
+    return success;
+}
